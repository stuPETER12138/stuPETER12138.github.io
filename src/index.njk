---
layout: base.njk
---
<div class="page-shell">
  <aside class="profile" aria-label="个人信息">
    <div class="portrait-wrap">
      {% if site.portrait %}<img class="portrait" src="{{ site.portrait | url }}" alt="{{ site.name }}的肖像" width="176" height="176">{% else %}<div class="portrait portrait-placeholder" role="img" aria-label="待添加个人肖像"><span>{{ site.initials }}</span><i aria-hidden="true"></i></div>{% endif %}
      <span class="profile-caption">RESEARCHER / EXPLORER</span>
    </div>
    <h1>{{ site.name }}</h1>
    <p class="english-name">{{ site.englishName }}</p>
    <p class="profile-role">{{ site.role }}</p>
    <p class="affiliation">{{ site.department }}<br>{{ site.institution }}</p>
    <p class="location"><span aria-hidden="true">⌖</span> {{ site.location }}</p>
    <div class="profile-links">
      {% if site.email %}<a href="mailto:{{ site.email | escape }}">Email <span aria-hidden="true">↗</span></a>{% endif %}
      {% for link in site.social %}<a href="{{ link.url | escape }}">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}
      {% if site.cv %}<a href="{{ site.cv | url }}">Curriculum Vitae <span aria-hidden="true">↓</span></a>{% endif %}
    </div>
    <div class="profile-note"><span class="small-label">A NOTE TO SELF</span><p>{{ site.tagline }}</p></div>
  </aside>
  <div class="main-column">
    <section class="intro-section" id="about" aria-labelledby="about-title">
      <div class="eyebrow"><span></span> PERSONAL ACADEMIC HOMEPAGE</div>
      <h2 id="about-title">探索问题，<br>也探索<span class="accent">可能性。</span></h2>
      <p class="lead">{{ site.intro }}</p>
      {% for paragraph in site.about %}<p>{{ paragraph }}</p>{% endfor %}
      <a class="text-link" href="#research">了解我的研究 <span aria-hidden="true">↘</span></a>
    </section>
    <section id="news" aria-labelledby="news-title">
      <div class="section-heading"><h2 id="news-title">最新动态 <span>News</span></h2><span class="section-index">01 /</span></div>
      {% if site.news.length %}<ul class="news-list">{% for item in site.news %}<li><time datetime="{{ item.date }}">{{ item.date }}</time><div>{% if item.tag %}<span class="news-tag">{{ item.tag }}</span>{% endif %}{{ item.text }}{% if item.url %} <a href="{{ item.url | escape }}">了解更多 ↗</a>{% endif %}</div></li>{% endfor %}</ul>{% else %}<div class="empty-state"><span class="empty-symbol" aria-hidden="true">↗</span><div><h3>新的探索，即将记录于此</h3><p>这里将分享研究进展、学术交流与近期动态。</p></div></div>{% endif %}
    </section>
    <section id="research" aria-labelledby="research-title">
      <div class="section-heading"><h2 id="research-title">研究方向 <span>Research</span></h2><span class="section-index">02 /</span></div>
      <div class="research-grid">{% for item in site.research %}<article class="research-card"><span class="card-number">{{ item.number }}</span><h3>{{ item.title }}</h3><p>{{ item.description }}</p><div class="tags">{% for tag in item.tags %}<span>{{ tag }}</span>{% endfor %}</div></article>{% endfor %}</div>
    </section>
    <section id="publications" aria-labelledby="publications-title">
      <div class="section-heading"><h2 id="publications-title">学术成果 <span>Publications</span></h2><span class="section-index">03 /</span></div>
      {% if publications.length %}
        <div class="publications-toolbar">
          <p><strong>{{ publications.length }}</strong> 篇成果 <span aria-hidden="true">·</span> 按年份排列</p>
          <a href="{{ '/papers.bib' | url }}" download>下载 BibTeX <span aria-hidden="true">↓</span></a>
        </div>
        <div class="publication-list">
          {% for paper in publications %}
            <article class="publication">
              <div class="publication-meta">
                <span class="paper-type">{{ paper.typeLabel | escape }}</span>
                <span class="publication-year">{{ paper.year or '年份未提供' }}</span>
                <span class="paper-index" aria-label="第 {{ loop.index }} 篇">{{ loop.index }}</span>
              </div>
              <h3>{% if paper.url %}<a href="{{ paper.url | escape }}">{{ paper.title | escape }}</a>{% else %}{{ paper.title | escape }}{% endif %}</h3>
              {% if paper.authors %}<p class="authors">{{ paper.authors | escape }}</p>{% endif %}
              {% if paper.venue or paper.pages %}
                <p class="venue">
                  {% if paper.venue %}<span class="venue-name">{{ paper.venue | escape }}</span>{% endif %}{% if paper.pages %}<span class="venue-pages">{% if paper.venue %} · {% endif %}pp. {{ paper.pages | escape }}</span>{% endif %}
                </p>
              {% endif %}
              {% if paper.note %}<p class="paper-note">{{ paper.note | escape }}</p>{% endif %}
              {% if paper.links.length or paper.abstract %}
                <div class="publication-resources">
                  {% if paper.links.length %}<div class="paper-links" aria-label="论文资源">{% for link in paper.links %}<a href="{{ link.url | escape }}">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>{% endif %}
                  {% if paper.abstract %}<details><summary>阅读摘要 <span class="summary-icon" aria-hidden="true">＋</span></summary><p>{{ paper.abstract | escape }}</p></details>{% endif %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-state"><span class="empty-symbol" aria-hidden="true">≡</span><div><h3>让研究慢慢积累</h3><p>此处预留论文、预印本和开源项目列表，尚未添加学术成果。</p></div></div>
      {% endif %}
    </section>
    <section id="experience" aria-labelledby="experience-title">
      <div class="section-heading"><h2 id="experience-title">学习与经历 <span>Experience</span></h2><span class="section-index">04 /</span></div>
      {% if site.experience.length %}<ol class="timeline">{% for item in site.experience %}<li><span class="timeline-date">{{ item.period }}</span><h3>{{ item.title }}</h3><p>{{ item.organization }}</p>{% if item.description %}<p>{{ item.description }}</p>{% endif %}</li>{% endfor %}</ol>{% else %}<p class="muted">待添加教育背景、研究经历与学术服务。</p>{% endif %}
    </section>
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><span class="small-label">LET’S CONNECT</span><h2 id="contact-title">好的想法，始于交流。</h2><p>欢迎围绕研究问题、学术合作或有趣的想法与我交流。</p>{% if site.email %}<a class="contact-link" href="mailto:{{ site.email | escape }}">{{ site.email }} <span aria-hidden="true">↗</span></a>{% else %}<p class="muted contact-placeholder">联系方式待补充</p>{% endif %}</section>
  </div>
</div>
